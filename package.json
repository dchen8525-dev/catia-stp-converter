{
  "name": "catia-stp-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Upload CATIA 3D models (CATPart / CATProduct) and convert to STEP via a serial job queue driving CATIA COM automation",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "worker": "node server/worker.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
